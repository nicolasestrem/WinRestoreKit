<UserControl x:Class="WinRestoreKit.Wpf.Views.ConfirmView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="ConfirmView_Loaded"
             AutomationProperties.Name="Confirm restore">
  <!-- Shared keys from Themes/Controls.xaml are referenced with DynamicResource: these views are
       loaded by tests on a bare STA thread where Application.Current is null, so a StaticResource
       lookup for an app-level key throws during InitializeComponent. Keys declared below are
       local to this file and resolve statically. -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <Style x:Key="ReviewItemStyle" TargetType="{x:Type TextBlock}">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <Style x:Key="GroupCaptionStyle" TargetType="{x:Type TextBlock}">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>

    <Style x:Key="SectionGlyphStyle" TargetType="{x:Type TextBlock}">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,0,10,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Resources>

  <Grid Margin="24,20,24,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="Review restore impact" Style="{DynamicResource PageTitleStyle}"
                 Foreground="{DynamicResource TextBrush}" />
      <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
        <TextBlock Text="Restoring from" FontSize="13" VerticalAlignment="Center"
                   Foreground="{DynamicResource MutedTextBrush}" />
        <TextBlock Text="{Binding Snapshot.DisplayName}" FontSize="13" FontWeight="SemiBold" Margin="5,0,0,0"
                   VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
        <TextBlock Text="{Binding Snapshot.Created, StringFormat='{}{0:d MMM yyyy, HH:mm}'}" FontSize="13"
                   Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
      </StackPanel>

      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource WarningBrush}"
              BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,14,0,0"
              MaxWidth="880" HorizontalAlignment="Left"
              Visibility="{Binding IsSourcePartial, Converter={StaticResource BooleanToVisibilityConverter}}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                     VerticalAlignment="Top" Margin="0,1,10,0"
                     Foreground="{DynamicResource WarningTextBrush}" />
          <StackPanel>
            <TextBlock Text="Selected source is partial." TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource WarningTextBrush}" />
            <TextBlock Text="Some modules may be missing from this snapshot. You will be asked to consent again before anything is written."
                       TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0"
                       Foreground="{DynamicResource MutedTextBrush}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel MaxWidth="880" HorizontalAlignment="Left" Margin="0,0,0,16">

        <Border Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,12">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Modules to restore" Style="{DynamicResource SectionTitleStyle}"
                         Foreground="{DynamicResource TextBrush}" />
              <TextBlock Margin="8,0,0,0" FontSize="13" VerticalAlignment="Center"
                         Foreground="{DynamicResource MutedTextBrush}">
                <Run Text="{Binding Modules.Count, Mode=OneWay}" />
                <Run Text="selected" />
              </TextBlock>
            </StackPanel>
            <ItemsControl x:Name="moduleList" ItemsSource="{Binding Modules}" Margin="0,10,0,0"
                          AutomationProperties.Name="Modules selected for restore">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="&#xE73E;" Style="{StaticResource SectionGlyphStyle}"
                               Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="{Binding Title}" Style="{StaticResource ReviewItemStyle}" Margin="0" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="No modules are selected. Go back to Compare and add at least one module."
                       Margin="0,10,0,0">
              <TextBlock.Style>
                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource GroupCaptionStyle}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasItems, ElementName=moduleList}" Value="False">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Border>

        <Grid>
          <Grid.Style>
            <Style TargetType="{x:Type Grid}">
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding HasItems, ElementName=consentList}" Value="False" />
                    <Condition Binding="{Binding HasItems, ElementName=informationalList}" Value="False" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Collapsed" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>
          <Border Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Applications" Style="{DynamicResource SectionTitleStyle}"
                         Foreground="{DynamicResource TextBrush}" />

              <StackPanel Margin="0,12,0,0">
                <StackPanel.Style>
                  <Style TargetType="{x:Type StackPanel}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasItems, ElementName=consentList}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <TextBlock Text="You will be asked to close these before anything is written."
                           Style="{StaticResource GroupCaptionStyle}" />
                <ItemsControl x:Name="consentList" ItemsSource="{Binding ConsentProcesses}"
                              AutomationProperties.Name="Applications requiring consent to close">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource SectionGlyphStyle}"
                                   Foreground="{DynamicResource WarningTextBrush}" />
                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource ReviewItemStyle}" Margin="0" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel Margin="0,14,0,0">
                <StackPanel.Style>
                  <Style TargetType="{x:Type StackPanel}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasItems, ElementName=informationalList}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <TextBlock Text="These close and come back on their own; Windows restarts them."
                           Style="{StaticResource GroupCaptionStyle}" />
                <ItemsControl x:Name="informationalList" ItemsSource="{Binding InformationalProcesses}"
                              AutomationProperties.Name="Applications that will restart themselves">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="&#xE946;" Style="{StaticResource SectionGlyphStyle}"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource ReviewItemStyle}" Margin="0" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>

        <Grid>
          <Grid.Style>
            <Style TargetType="{x:Type Grid}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasItems, ElementName=explorerList}" Value="False">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>
          <Border Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Windows Explorer" Style="{DynamicResource SectionTitleStyle}"
                         Foreground="{DynamicResource TextBrush}" />
              <TextBlock Text="After a successful write, these modules may offer to restart Explorer so the change appears."
                         Style="{StaticResource GroupCaptionStyle}" Margin="0,8,0,6" />
              <ItemsControl x:Name="explorerList" ItemsSource="{Binding ExplorerRestartModules}"
                            AutomationProperties.Name="Modules that may offer Explorer restart">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource ReviewItemStyle}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </Grid>

        <Grid>
          <Grid.Style>
            <Style TargetType="{x:Type Grid}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasItems, ElementName=warningList}" Value="False">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>
          <Border Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,12"
                  BorderBrush="{DynamicResource WarningBrush}">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                           Margin="0,0,10,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource WarningTextBrush}" />
                <TextBlock Text="Before you continue" Style="{DynamicResource SectionTitleStyle}"
                           Foreground="{DynamicResource TextBrush}" />
              </StackPanel>
              <ItemsControl x:Name="warningList" ItemsSource="{Binding ModuleWarnings}" Margin="0,10,0,0"
                            AutomationProperties.Name="Existing module warnings">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,0,0,10">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                 Foreground="{DynamicResource TextBrush}" />
                      <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0"
                                 Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </Grid>

        <Grid>
          <Grid.Style>
            <Style TargetType="{x:Type Grid}">
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding ProgressText}" Value="" />
                    <Condition Binding="{Binding Summary}" Value="{x:Null}" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Collapsed" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>
          <Border Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Restore status" Style="{DynamicResource SectionTitleStyle}"
                         Foreground="{DynamicResource TextBrush}" />
              <TextBlock Text="{Binding ProgressText}" TextWrapping="Wrap" FontSize="13" Margin="0,10,0,0"
                         Foreground="{DynamicResource MutedTextBrush}">
                <TextBlock.Style>
                  <Style TargetType="{x:Type TextBlock}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ProgressText}" Value="">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <StackPanel Margin="0,10,0,0">
                <StackPanel.Style>
                  <Style TargetType="{x:Type StackPanel}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Summary}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <TextBlock Text="{Binding Summary.Headline}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextBrush}" />
                <TextBlock Text="{Binding Summary.Detail}" TextWrapping="Wrap" FontSize="13" Margin="0,4,0,0"
                           Foreground="{DynamicResource MutedTextBrush}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="2,2,0,0">
          <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                     VerticalAlignment="Top" Margin="0,1,10,0"
                     Foreground="{DynamicResource MutedTextBrush}" />
          <TextBlock Text="{Binding FidelityCaveat}" TextWrapping="Wrap" FontSize="12" MaxWidth="820"
                     Foreground="{DynamicResource MutedTextBrush}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
            Padding="0,14,0,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource MutedTextBrush}">
          <Run Text="{Binding Modules.Count, Mode=OneWay}" />
          <Run Text="modules will be written from this snapshot." />
        </TextBlock>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Back to compare" Command="{Binding BackToCompareCommand}" IsEnabled="{Binding CanNavigate}"
                  Style="{DynamicResource SecondaryButtonStyle}" />
          <Button Content="Cancel restore" Command="{Binding CancelRestoreCommand}" IsEnabled="{Binding IsRestoring}" Margin="8,0,0,0"
                  Style="{DynamicResource DangerButtonStyle}" />
          <Button Command="{Binding StartRestoreCommand}" IsEnabled="{Binding CanStartRestore}" Margin="8,0,0,0"
                  Style="{DynamicResource PrimaryButtonStyle}"
                  AutomationProperties.Name="Continue to final restore consent" AutomationProperties.AutomationId="ConfirmRestoreButton">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Continue to restore" VerticalAlignment="Center" />
              <TextBlock Text="&#xE72A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                         Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
