<UserControl x:Class="WinRestoreKit.Wpf.Views.AdvancedHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded"
             AutomationProperties.Name="Advanced history">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/WinRestoreKit.Wpf;component/Resources/SnapshotEventTemplates.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Declared locally rather than derived from the app-level implicit style: views are
           constructed in tests without an Application, where app-level StaticResource would throw. -->
      <Style x:Key="HistoryRowStyle" TargetType="{x:Type ListViewItem}">
        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
        <Setter Property="Padding" Value="0,7" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListViewItem}">
              <Border x:Name="Row"
                      Background="Transparent"
                      BorderBrush="{DynamicResource DividerBrush}"
                      BorderThickness="0,0,0,1"
                      SnapsToDevicePixels="True">
                <GridViewRowPresenter Margin="{TemplateBinding Padding}"
                                      Columns="{TemplateBinding GridView.ColumnCollection}"
                                      Content="{TemplateBinding Content}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectedBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                  <Setter TargetName="Row" Property="BorderThickness" Value="0,0,0,2" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="HistoryWatermarkStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
            <Setter Property="Visibility" Value="Visible" />
          </DataTrigger>
          <DataTrigger Binding="{Binding SearchText}" Value="">
            <Setter Property="Visibility" Value="Visible" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>
  <Border Background="{DynamicResource WindowBackgroundBrush}"
          TextElement.Foreground="{DynamicResource TextBrush}"
          TextElement.FontFamily="{DynamicResource ApplicationFont}"
          Padding="32,26,32,24">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <StackPanel>
        <TextBlock Text="Advanced history" Style="{DynamicResource PageTitleStyle}" />
        <TextBlock Text="The same snapshot events as the timeline, shown with exact timestamps, machines, paths, and sizes."
                   Margin="0,6,0,0" MaxWidth="720" HorizontalAlignment="Left"
                   FontSize="13" TextWrapping="Wrap"
                   Foreground="{DynamicResource MutedTextBrush}" />
      </StackPanel>

      <Grid Grid.Row="1" Margin="0,20,0,14" HorizontalAlignment="Left" Width="380">
        <TextBox x:Name="HistorySearchBox"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="Search snapshots"
                 AutomationProperties.HelpText="Search by snapshot name, machine, path, or status." />
        <TextBlock Text="Search name, machine, path, or status"
                   Style="{StaticResource HistoryWatermarkStyle}"
                   Margin="11,0,0,0" VerticalAlignment="Center"
                   IsHitTestVisible="False" FontSize="13"
                   FontFamily="{DynamicResource ApplicationFont}"
                   Foreground="{DynamicResource DisabledTextBrush}" />
      </Grid>

      <Border Grid.Row="2"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource DividerBrush}"
              BorderThickness="1" CornerRadius="8"
              SnapsToDevicePixels="True">
        <ListView x:Name="AdvancedHistoryEventList"
                  Margin="1"
                  ItemsSource="{Binding Events}"
                  SelectedItem="{Binding SelectedEvent, Mode=TwoWay}"
                  SelectionMode="Single"
                  Background="Transparent"
                  BorderThickness="0"
                  ItemContainerStyle="{StaticResource HistoryRowStyle}"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  AutomationProperties.Name="Snapshot history">
          <ListView.View>
            <GridView>
              <GridViewColumn Header="Timestamp" Width="210">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Created, StringFormat={}{0:O}}"
                               Style="{DynamicResource TechnicalTextStyle}"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               VerticalAlignment="Center" />
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="Machine" Width="130" DisplayMemberBinding="{Binding MachineName}" />
              <GridViewColumn Header="Path" Width="280">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding CanonicalPath}"
                               Style="{DynamicResource TechnicalTextStyle}"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               ToolTip="{Binding CanonicalPath}"
                               VerticalAlignment="Center" />
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="Status" Width="180">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <ContentPresenter Content="{Binding Status}"
                                      ContentTemplate="{StaticResource SnapshotEventStatusTemplate}" />
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="Size" Width="90" DisplayMemberBinding="{Binding SizeDisplay}" />
              <GridViewColumn Header="Diagnostics" Width="300">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding DiagnosticReason}"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               ToolTip="{Binding DiagnosticReason}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource WarningTextBrush}" />
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
            </GridView>
          </ListView.View>
        </ListView>
      </Border>
    </Grid>
  </Border>
</UserControl>
