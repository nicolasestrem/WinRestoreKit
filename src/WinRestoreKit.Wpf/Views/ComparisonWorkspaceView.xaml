<UserControl x:Class="WinRestoreKit.Wpf.Views.ComparisonWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Snapshot comparison workspace"
             AutomationProperties.AutomationId="ComparisonWorkspace">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <!-- Evidence state is text + glyph + position, never colour alone. StateLabel carries the
         Core enum name; the triggers below are the only place NotCaptured becomes readable. -->
    <Style x:Key="StateGlyphStyle" TargetType="{x:Type TextBlock}">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Text" Value="&#xE72C;" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding StateLabel}" Value="Changed">
          <Setter Property="Text" Value="&#xE895;" />
          <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StateLabel}" Value="Same">
          <Setter Property="Text" Value="&#xE73E;" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StateLabel}" Value="Unavailable">
          <Setter Property="Text" Value="&#xE7BA;" />
          <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StateLabel}" Value="NotCaptured">
          <Setter Property="Text" Value="&#xE946;" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="StateNameStyle" TargetType="{x:Type TextBlock}">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="Text" Value="Checking" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding StateLabel}" Value="Changed">
          <Setter Property="Text" Value="Changed" />
          <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StateLabel}" Value="Same">
          <Setter Property="Text" Value="Same" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StateLabel}" Value="Unavailable">
          <Setter Property="Text" Value="Unavailable" />
          <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StateLabel}" Value="NotCaptured">
          <Setter Property="Text" Value="Not captured" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- RestoreTargetKind reaches the tray as an enum; never show the member name. -->
    <Style x:Key="TargetKindStyle" TargetType="{x:Type TextBlock}">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="Text" Value="Command" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="RegistryKey">
          <Setter Property="Text" Value="Registry key" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Folder">
          <Setter Property="Text" Value="Folder" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="File">
          <Setter Property="Text" Value="File" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- NeedsConsent is a bool; "True" is not an answer a user can act on. -->
    <Style x:Key="ConsentNoteStyle" TargetType="{x:Type TextBlock}">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="Text" Value="Closes and restarts on its own." />
      <Style.Triggers>
        <DataTrigger Binding="{Binding NeedsConsent}" Value="True">
          <Setter Property="Text" Value="You will be asked before this is closed." />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="FilterChipStyle" TargetType="{x:Type RadioButton}">
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type RadioButton}">
            <Border x:Name="chip" CornerRadius="6" Padding="{TemplateBinding Padding}"
                    Background="Transparent" BorderThickness="1"
                    BorderBrush="{DynamicResource DividerBrush}" SnapsToDevicePixels="True">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="check" Text="&#xE73E;" FontSize="12" Margin="0,0,6,0"
                           VerticalAlignment="Center" Visibility="Collapsed"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           Foreground="{DynamicResource AccentBrush}" />
                <ContentPresenter VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="chip" Property="Background" Value="{DynamicResource SurfaceBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="chip" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                <Setter TargetName="chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="check" Property="Visibility" Value="Visible" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="chip" Property="BorderThickness" Value="2" />
                <Setter TargetName="chip" Property="Padding" Value="11,5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FlatListBoxStyle" TargetType="{x:Type ListBox}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style x:Key="EvidenceRowStyle" TargetType="{x:Type ListBoxItem}">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ListBoxItem}">
            <Grid SnapsToDevicePixels="True">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border x:Name="marker" Grid.Column="0" Background="Transparent" CornerRadius="2,0,0,2" />
              <Border x:Name="fill" Grid.Column="1" Background="Transparent"
                      BorderBrush="Transparent" BorderThickness="0,0,0,1">
                <ContentPresenter Margin="0" />
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="fill" Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="fill" Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
                <Setter TargetName="marker" Property="Background" Value="{DynamicResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="fill" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="fill" Property="BorderThickness" Value="2" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="RestoreSetRowStyle" TargetType="{x:Type ListBoxItem}">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ListBoxItem}">
            <Border x:Name="fill" Background="Transparent" BorderBrush="Transparent"
                    BorderThickness="1" CornerRadius="4" Padding="8,5" SnapsToDevicePixels="True">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="fill" Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="fill" Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="fill" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Which snapshot the evidence below is measured against. -->
    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="Compare" Style="{DynamicResource PageTitleStyle}"
                 Foreground="{DynamicResource TextBrush}" />
      <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
        <TextBlock Text="Current PC against" FontSize="13"
                   Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Snapshot.DisplayName}" FontSize="13" FontWeight="SemiBold"
                   Margin="5,0,0,0" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Snapshot.Created, StringFormat='{}{0:d MMM yyyy, HH:mm}'}"
                   FontSize="13" Margin="10,0,0,0" Foreground="{DynamicResource MutedTextBrush}"
                   VerticalAlignment="Center" />
        <TextBlock Text="{Binding Snapshot.MachineName}" FontSize="13" Margin="10,0,0,0"
                   Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
        <Border BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="6"
                Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
          <Border.Style>
            <Style TargetType="{x:Type Border}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Snapshot.Kind}" Value="Partial">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <TextBlock Text="Partial snapshot" Style="{DynamicResource PillTextStyle}"
                     Foreground="{DynamicResource WarningTextBrush}" />
        </Border>
      </StackPanel>
    </StackPanel>

    <!-- Filters lead the keyboard path, exactly as before. -->
    <Grid Grid.Row="1" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Show" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"
                   Foreground="{DynamicResource MutedTextBrush}" />
        <RadioButton Content="All modules" GroupName="ComparisonFilter" IsChecked="{Binding IsAllFilter, Mode=TwoWay}"
                     Style="{StaticResource FilterChipStyle}"
                     AutomationProperties.Name="Show all compared modules" AutomationProperties.AutomationId="CompareFilterAll" />
        <RadioButton Content="Changed only" GroupName="ComparisonFilter" Margin="8,0,0,0" IsChecked="{Binding IsChangedOnlyFilter, Mode=TwoWay}"
                     Style="{StaticResource FilterChipStyle}"
                     AutomationProperties.Name="Show only changed modules" AutomationProperties.AutomationId="CompareFilterChanged" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <TextBlock Text="Comparing modules&#8230;" FontSize="13" Margin="0,0,10,0"
                   Foreground="{DynamicResource MutedTextBrush}"
                   Visibility="{Binding IsComparing, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <TextBlock Text="{Binding ComparisonStatus}" FontSize="13"
                   Foreground="{DynamicResource MutedTextBrush}" />
      </StackPanel>
    </Grid>

    <!-- Two panes: evidence on the left, the restore set and detail tray on the right.
         Children are declared restore set -> continue -> evidence -> tray so the tab order
         is the one the workspace shipped with; Grid.Column/Row places them visually. -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="420" />
        <ColumnDefinition Width="360" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Column="1" Grid.Row="0" Style="{DynamicResource CardBorderStyle}"
              Padding="16" Margin="16,0,0,12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Restore set" Style="{DynamicResource SectionTitleStyle}"
                       Foreground="{DynamicResource TextBrush}" />
            <TextBlock Margin="8,0,0,0" FontSize="13" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedTextBrush}">
              <Run Text="{Binding RestoreSet.Modules.Count, Mode=OneWay}" />
              <Run Text="selected" />
            </TextBlock>
          </StackPanel>

          <Grid Grid.Row="1" Margin="0,10,0,0">
            <ListBox ItemsSource="{Binding RestoreSet.Modules}" MinWidth="220" MaxHeight="180"
                     Style="{StaticResource FlatListBoxStyle}"
                     ItemContainerStyle="{StaticResource RestoreSetRowStyle}"
                     AutomationProperties.Name="Modules selected for restore"
                     AutomationProperties.AutomationId="RestoreSetList">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE73E;" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextBrush}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="Nothing selected yet. Add a module from the list to build a restore set."
                       TextWrapping="Wrap" FontSize="13" IsHitTestVisible="False"
                       Foreground="{DynamicResource MutedTextBrush}">
              <TextBlock.Style>
                <Style TargetType="{x:Type TextBlock}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding RestoreSet.HasItems}" Value="False">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>

          <Button Grid.Row="2" Content="Continue to confirm" Command="{Binding ContinueToConfirmCommand}"
                  IsEnabled="{Binding CanContinueToConfirm}" Margin="0,14,0,0"
                  HorizontalAlignment="Stretch" Style="{DynamicResource PrimaryButtonStyle}"
                  AutomationProperties.Name="Review selected modules before restore" AutomationProperties.AutomationId="CompareContinueToConfirmButton" />
        </Grid>
      </Border>

      <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Style="{DynamicResource CardBorderStyle}" Padding="0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="16,12">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Evidence" Style="{DynamicResource SectionTitleStyle}"
                         Foreground="{DynamicResource TextBrush}" />
              <TextBlock Margin="8,0,0,0" FontSize="13" VerticalAlignment="Center"
                         Foreground="{DynamicResource MutedTextBrush}">
                <Run Text="{Binding VisibleRows.Count, Mode=OneWay}" />
                <Run Text="modules" />
              </TextBlock>
            </StackPanel>
          </Border>
          <Grid Grid.Row="1">
            <ListBox x:Name="compareModuleList" ItemsSource="{Binding VisibleRows}" SelectedItem="{Binding SelectedRow}"
                     Style="{StaticResource FlatListBoxStyle}"
                     ItemContainerStyle="{StaticResource EvidenceRowStyle}"
                     AutomationProperties.Name="Compared modules"
                     AutomationProperties.AutomationId="CompareModuleList">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="12,10,12,10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="130" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,1,8,0">
                      <TextBlock Style="{StaticResource StateGlyphStyle}" />
                      <TextBlock Style="{StaticResource StateNameStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{DynamicResource TextBrush}" />
                        <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="6"
                                Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center">
                          <Border.Style>
                            <Style TargetType="{x:Type Border}">
                              <Setter Property="Visibility" Value="Collapsed" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsInRestoreSet}" Value="True">
                                  <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <TextBlock Text="In restore set" Style="{DynamicResource PillTextStyle}"
                                     Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                      </StackPanel>
                      <TextBlock Text="{Binding ArtifactSummary}" TextWrapping="Wrap" FontSize="12"
                                 Margin="0,3,0,0" Foreground="{DynamicResource MutedTextBrush}" />
                      <TextBlock Text="This snapshot has no artifact to restore for this module."
                                 TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0"
                                 Foreground="{DynamicResource WarningTextBrush}">
                        <TextBlock.Style>
                          <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                  <Condition Binding="{Binding IsChecking}" Value="False" />
                                  <Condition Binding="{Binding CanChangeRestoreSet}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                              </MultiDataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="2" Content="{Binding RestoreActionLabel}" Command="{Binding ToggleRestoreSetCommand}"
                            IsEnabled="{Binding CanChangeRestoreSet}" VerticalAlignment="Top" Margin="12,0,0,0"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            AutomationProperties.Name="{Binding RestoreActionAutomationName}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="No changed modules yet. Switch to All modules to see every comparison result."
                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                       Foreground="{DynamicResource MutedTextBrush}">
              <TextBlock.Style>
                <Style TargetType="{x:Type TextBlock}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasItems, ElementName=compareModuleList}" Value="False">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Column="1" Grid.Row="1" Style="{DynamicResource CardBorderStyle}" Padding="0" Margin="16,0,0,0"
              Visibility="{Binding IsDetailTrayOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
              AutomationProperties.Name="Selected module details">
        <Border.Effect>
          <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.14" Color="#FF000000" />
        </Border.Effect>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
          <StackPanel DataContext="{Binding SelectedRow}">
            <TextBlock Text="{Binding Title}" Style="{DynamicResource SectionTitleStyle}"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
            <TextBlock Text="{Binding Category}" FontSize="12" Margin="0,2,0,0"
                       Foreground="{DynamicResource MutedTextBrush}" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <TextBlock Style="{StaticResource StateGlyphStyle}" />
              <TextBlock Style="{StaticResource StateNameStyle}" />
            </StackPanel>
            <TextBlock Text="{Binding ArtifactSummary}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"
                       Foreground="{DynamicResource MutedTextBrush}" />
            <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"
                       Foreground="{DynamicResource MutedTextBrush}">
              <TextBlock.Style>
                <Style TargetType="{x:Type TextBlock}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Reason}" Value="">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>

            <TextBlock Text="What a restore overwrites" Margin="0,16,0,0" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}" />
            <ItemsControl ItemsSource="{Binding Impact.Targets}" Margin="0,6,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource TargetKindStyle}" />
                    <TextBlock Text="{Binding Path}" TextWrapping="Wrap" Margin="0,1,0,0"
                               Style="{DynamicResource TechnicalTextStyle}"
                               Foreground="{DynamicResource TextBrush}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Margin="0,8,0,0">
              <StackPanel.Style>
                <Style TargetType="{x:Type StackPanel}">
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Impact.Processes.Count}" Value="0">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <TextBlock Text="Applications affected" FontSize="12" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextBrush}" />
              <ItemsControl ItemsSource="{Binding Impact.Processes}" Margin="0,6,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,0,0,8">
                      <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                 Foreground="{DynamicResource TextBrush}" />
                      <TextBlock Style="{StaticResource ConsentNoteStyle}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <TextBlock Text="Explorer restart may be offered after successful writes."
                       TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"
                       Foreground="{DynamicResource MutedTextBrush}"
                       Visibility="{Binding Impact.RequiresExplorerRestart, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <Border BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1,0,0,0"
                    Padding="10,2,0,2" Margin="0,12,0,0">
              <Border.Style>
                <Style TargetType="{x:Type Border}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Impact.WarningMessage}" Value="">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <TextBlock Text="{Binding Impact.WarningMessage}" TextWrapping="Wrap" FontSize="12"
                         Foreground="{DynamicResource WarningTextBrush}" />
            </Border>

            <Button Content="{Binding RestoreActionLabel}" Command="{Binding ToggleRestoreSetCommand}"
                    IsEnabled="{Binding CanChangeRestoreSet}" Margin="0,16,0,0"
                    HorizontalAlignment="Stretch" Style="{DynamicResource SecondaryButtonStyle}" />
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Border Grid.Column="1" Grid.Row="1" Margin="16,0,0,0" Padding="16"
              BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="8"
              Background="Transparent" IsHitTestVisible="False">
        <Border.Style>
          <Style TargetType="{x:Type Border}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsDetailTrayOpen}" Value="False">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <TextBlock Text="Select a module to see its evidence, what a restore overwrites, and which applications it affects."
                   TextWrapping="Wrap" FontSize="13" VerticalAlignment="Top"
                   Foreground="{DynamicResource MutedTextBrush}" />
      </Border>
    </Grid>
  </Grid>
</UserControl>
