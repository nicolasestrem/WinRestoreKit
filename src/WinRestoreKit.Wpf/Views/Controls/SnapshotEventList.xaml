<UserControl x:Class="WinRestoreKit.Wpf.Views.Controls.SnapshotEventList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/WinRestoreKit.Wpf;component/Resources/SnapshotEventTemplates.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!--
        The container contributes no chrome of its own: the card, the rail node, and every
        selection and focus visual are drawn by SnapshotEventRowTemplate so the row stays
        one designed object rather than a themed list row inside a themed list box.
      -->
      <Style x:Key="TimelineEventItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <EventSetter Event="MouseDoubleClick" Handler="OnItemMouseDoubleClick" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListBoxItem}">
              <Grid Background="Transparent">
                <ContentPresenter HorizontalAlignment="Stretch" />
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid>
    <!-- Continuous time axis. Nodes are painted over it with an opaque backing. -->
    <Border x:Name="TimelineConnector"
            Width="2"
            Margin="23,0,0,0"
            HorizontalAlignment="Left"
            Background="{DynamicResource DividerBrush}"
            IsHitTestVisible="False"
            Visibility="Collapsed" />
    <ListBox x:Name="TimelineEventList"
             ItemsSource="{Binding Events}"
             SelectedItem="{Binding SelectedEvent, Mode=TwoWay}"
             SelectionMode="Single"
             AutomationProperties.Name="Snapshots"
             AutomationProperties.AutomationId="TimelineEventList"
             AutomationProperties.HelpText="Left and Right Arrow move snapshots. Double-click or press Enter to open a verified or partial snapshot; failed and unreadable entries open details."
             KeyboardNavigation.DirectionalNavigation="Continue"
             ItemTemplate="{StaticResource SnapshotEventRowTemplate}"
             ItemContainerStyle="{StaticResource TimelineEventItemStyle}"
             Background="Transparent"
             BorderThickness="0"
             Padding="0"
             Focusable="True"
             VirtualizingPanel.IsVirtualizing="False"
             ScrollViewer.CanContentScroll="False"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ScrollViewer.VerticalScrollBarVisibility="Auto"
             PreviewKeyDown="OnPreviewKeyDown"
             SelectionChanged="OnSelectionChanged">
      <ListBox.Template>
        <ControlTemplate TargetType="{x:Type ListBox}">
          <ScrollViewer Focusable="False"
                        Padding="{TemplateBinding Padding}"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <ItemsPresenter SnapsToDevicePixels="True" />
          </ScrollViewer>
        </ControlTemplate>
      </ListBox.Template>
    </ListBox>
  </Grid>
</UserControl>
