<UserControl x:Class="WinRestoreKit.Wpf.Views.ProgressWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Snapshot progress"
             AutomationProperties.AutomationId="ProgressWorkspace">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <!-- Run state is stated in words, never by colour alone, and only one pill is ever shown. -->
    <Style x:Key="RunningPillStyle" TargetType="{x:Type Border}">
      <Setter Property="Visibility" Value="Collapsed" />
      <Setter Property="Padding" Value="10,3,10,4" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Style.Triggers>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding IsPaused}" Value="False" />
            <Condition Binding="{Binding IsCancellationRequested}" Value="False" />
          </MultiDataTrigger.Conditions>
          <Setter Property="Visibility" Value="Visible" />
        </MultiDataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="PausedPillStyle" TargetType="{x:Type Border}">
      <Setter Property="Visibility" Value="Collapsed" />
      <Setter Property="Padding" Value="10,3,10,4" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Style.Triggers>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding IsPaused}" Value="True" />
            <Condition Binding="{Binding IsCancellationRequested}" Value="False" />
          </MultiDataTrigger.Conditions>
          <Setter Property="Visibility" Value="Visible" />
        </MultiDataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="CancelRequestedPillStyle" TargetType="{x:Type Border}">
      <Setter Property="Visibility" Value="Collapsed" />
      <Setter Property="Padding" Value="10,3,10,4" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsCancellationRequested}" Value="True">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="MetricCaptionStyle" TargetType="{x:Type TextBlock}">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>

    <Style x:Key="MetricValueStyle" TargetType="{x:Type TextBlock}">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Margin" Value="0,2,0,0" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <!-- A non-zero count is the exception, so it is what changes weight and colour. -->
    <Style x:Key="ErrorCountStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MetricValueStyle}">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Errors}" Value="0">
          <Setter Property="FontWeight" Value="Normal" />
          <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="WarningCountStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MetricValueStyle}">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Warnings}" Value="0">
          <Setter Property="FontWeight" Value="Normal" />
          <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Log rows are read, not picked: no selection highlight, no per-row chrome. -->
    <Style x:Key="LogRowStyle" TargetType="{x:Type ListBoxItem}">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ListBoxItem}">
            <Border Background="Transparent" Padding="0,2,0,2">
              <ContentPresenter />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="EmptyLogHintStyle" TargetType="{x:Type TextBlock}">
      <Setter Property="Visibility" Value="Collapsed" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding HasItems, ElementName=ProgressLogList}" Value="False">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Border Background="{DynamicResource WindowBackgroundBrush}" Padding="32,26,32,24">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Snapshot run"
                     Style="{DynamicResource CaptionTextStyle}"
                     Foreground="{DynamicResource MutedTextBrush}" />
          <TextBlock x:Name="ProgressStatusText"
                     Text="{Binding ProgressText}"
                     Style="{DynamicResource PageTitleStyle}"
                     Foreground="{DynamicResource TextBrush}"
                     FontSize="24"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap"
                     Margin="0,4,0,0"
                     AutomationProperties.Name="Snapshot progress status"
                     AutomationProperties.AutomationId="ProgressStatusText"
                     AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                    Margin="20,0,0,0"
                    AutomationProperties.Name="Run state">
          <Border Style="{StaticResource RunningPillStyle}">
            <TextBlock Text="Running"
                       Style="{DynamicResource PillTextStyle}"
                       Foreground="{DynamicResource AccentTextBrush}" />
          </Border>
          <Border Style="{StaticResource PausedPillStyle}">
            <TextBlock Text="Paused"
                       Style="{DynamicResource PillTextStyle}"
                       Foreground="{DynamicResource WarningTextBrush}" />
          </Border>
          <Border Style="{StaticResource CancelRequestedPillStyle}">
            <TextBlock Text="Cancellation requested"
                       Style="{DynamicResource PillTextStyle}"
                       Foreground="{DynamicResource WarningTextBrush}" />
          </Border>
        </StackPanel>
      </Grid>

      <Border Grid.Row="1" Style="{DynamicResource CardBorderStyle}" Padding="20,18,20,18" Margin="0,20,0,0">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Stage"
                         Style="{StaticResource MetricCaptionStyle}" />
              <TextBlock Text="{Binding GroupInfo}"
                         Style="{DynamicResource BodyTextStyle}"
                         Foreground="{DynamicResource TextBrush}"
                         FontSize="15"
                         FontWeight="SemiBold"
                         TextWrapping="Wrap"
                         Margin="0,2,0,0" />
            </StackPanel>
            <TextBlock Grid.Column="1"
                       VerticalAlignment="Bottom"
                       Margin="20,0,0,0"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}"
                       AutomationProperties.Name="Percent complete">
              <Run Text="{Binding Percent, Mode=OneWay}" /><Run Text="%" />
            </TextBlock>
          </Grid>

          <ProgressBar x:Name="ProgressPercentBar"
                       Height="8"
                       Margin="0,14,0,0"
                       Minimum="0"
                       Maximum="100"
                       Value="{Binding Percent, Mode=OneWay}"
                       Foreground="{DynamicResource AccentBrush}"
                       Background="{DynamicResource SubtleBrush}"
                       BorderThickness="0"
                       AutomationProperties.Name="Snapshot progress percentage"
                       AutomationProperties.AutomationId="ProgressPercentBar">
            <ProgressBar.Template>
              <ControlTemplate TargetType="{x:Type ProgressBar}">
                <Border CornerRadius="4"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="1"
                        SnapsToDevicePixels="True">
                  <Grid x:Name="PART_Track" ClipToBounds="True">
                    <Border x:Name="PART_Indicator"
                            HorizontalAlignment="Left"
                            CornerRadius="3"
                            Background="{TemplateBinding Foreground}" />
                  </Grid>
                </Border>
              </ControlTemplate>
            </ProgressBar.Template>
          </ProgressBar>

          <Grid Margin="0,18,0,0" AutomationProperties.Name="Snapshot progress details">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" MinWidth="90" />
              <ColumnDefinition Width="Auto" MinWidth="90" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="Elapsed" Style="{StaticResource MetricCaptionStyle}" />
              <TextBlock Text="{Binding Elapsed}" Style="{StaticResource MetricValueStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,16,0">
              <TextBlock Text="Remaining" Style="{StaticResource MetricCaptionStyle}" />
              <TextBlock Text="{Binding Remaining}" Style="{StaticResource MetricValueStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,16,0">
              <TextBlock Text="Throughput" Style="{StaticResource MetricCaptionStyle}" />
              <TextBlock Text="{Binding Throughput}" Style="{StaticResource MetricValueStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="3" Margin="0,0,16,0">
              <TextBlock Text="Bytes written" Style="{StaticResource MetricCaptionStyle}" />
              <TextBlock Text="{Binding BytesWrittenText}" Style="{StaticResource MetricValueStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="4" Margin="0,0,16,0">
              <TextBlock Text="Errors" Style="{StaticResource MetricCaptionStyle}" />
              <TextBlock Text="{Binding Errors}" Style="{StaticResource ErrorCountStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="5">
              <TextBlock Text="Warnings" Style="{StaticResource MetricCaptionStyle}" />
              <TextBlock Text="{Binding Warnings}" Style="{StaticResource WarningCountStyle}" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <Border Grid.Row="2"
              Margin="0,12,0,0"
              Padding="14,10,16,11"
              CornerRadius="6"
              BorderThickness="1"
              BorderBrush="{DynamicResource WarningBrush}"
              Background="{DynamicResource SurfaceAltBrush}"
              Visibility="{Binding ExplorerRestartVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
              AutomationProperties.Name="Explorer restart requirement"
              AutomationProperties.LiveSetting="Polite">
        <StackPanel>
          <TextBlock Text="Explorer restart required"
                     Style="{DynamicResource CaptionTextStyle}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource WarningTextBrush}" />
          <TextBlock Text="Restored settings apply after Windows Explorer restarts."
                     Style="{DynamicResource BodyTextStyle}"
                     Foreground="{DynamicResource WarningTextBrush}"
                     TextWrapping="Wrap"
                     Margin="0,2,0,0" />
        </StackPanel>
      </Border>

      <Border Grid.Row="3" Style="{DynamicResource CardBorderStyle}" Padding="20,16,20,16" Margin="0,12,0,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,10">
            <TextBlock Text="Run log"
                       Style="{DynamicResource SectionTitleStyle}"
                       Foreground="{DynamicResource TextBrush}"
                       FontSize="15"
                       FontWeight="SemiBold" />
            <TextBlock Text="Exact messages written by the engine while the run is active."
                       Style="{DynamicResource CaptionTextStyle}"
                       Foreground="{DynamicResource MutedTextBrush}"
                       Margin="0,3,0,0" />
          </StackPanel>
          <Grid Grid.Row="1">
            <ListBox x:Name="ProgressLogList"
                     ItemsSource="{Binding LogLines}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     HorizontalContentAlignment="Stretch"
                     ItemContainerStyle="{StaticResource LogRowStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     AutomationProperties.Name="Snapshot run log"
                     AutomationProperties.AutomationId="ProgressLogList"
                     AutomationProperties.LiveSetting="Polite">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Text}"
                             Style="{DynamicResource TechnicalTextStyle}"
                             Foreground="{DynamicResource TextBrush}"
                             TextWrapping="Wrap" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="No log messages yet. Lines appear here as the run reports them."
                       Style="{StaticResource EmptyLogHintStyle}"
                       IsHitTestVisible="False" />
          </Grid>
        </Grid>
      </Border>

      <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
        <Button x:Name="PauseRunButton"
                Content="{Binding PauseCaption}"
                Command="{Binding PauseCommand}"
                Style="{DynamicResource SecondaryButtonStyle}"
                MinWidth="110"
                AutomationProperties.Name="Pause or resume snapshot"
                AutomationProperties.AutomationId="PauseRunButton" />
        <Button x:Name="CancelRunButton"
                Content="Cancel"
                Command="{Binding CancelCommand}"
                Style="{DynamicResource DangerButtonStyle}"
                MinWidth="110"
                Margin="8,0,0,0"
                AutomationProperties.Name="Cancel snapshot"
                AutomationProperties.AutomationId="CancelRunButton" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
