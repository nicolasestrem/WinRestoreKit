<UserControl x:Class="WinRestoreKit.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Settings workspace">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="720" HorizontalAlignment="Left" Margin="24,20,24,24">
      <TextBlock Text="Settings" Style="{DynamicResource PageTitleStyle}"
                 Foreground="{DynamicResource TextBrush}" />
      <TextBlock Text="Preferences apply immediately and are kept for the next time you open WinRestoreKit."
                 TextWrapping="Wrap" FontSize="13" Margin="0,4,0,0"
                 Foreground="{DynamicResource MutedTextBrush}" />

      <Border Style="{DynamicResource CardBorderStyle}" Margin="0,18,0,0">
        <StackPanel>
          <TextBlock Text="Appearance" Style="{DynamicResource SectionTitleStyle}"
                     Foreground="{DynamicResource TextBrush}" />
          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
              <Label Content="Theme" Target="{Binding ElementName=themeSelector}" Padding="0"
                     FontWeight="SemiBold" FontSize="13"
                     Foreground="{DynamicResource TextBrush}" AutomationProperties.Name="Theme label" />
              <TextBlock Text="Follow system matches your Windows light or dark setting. Light and Dark stay fixed regardless of Windows."
                         TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"
                         Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
            <ComboBox x:Name="themeSelector" Grid.Column="1" ItemsSource="{Binding AvailableModes}"
                      SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                      MinWidth="180" VerticalAlignment="Center"
                      AutomationProperties.Name="Theme"
                      AutomationProperties.AutomationId="SettingsThemeSelector">
              <ComboBox.ItemContainerStyle>
                <Style TargetType="{x:Type ComboBoxItem}">
                  <Setter Property="AutomationProperties.Name" Value="Follow system" />
                  <Setter Property="AutomationProperties.AutomationId" Value="SettingsThemeFollowSystem" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding}" Value="Light">
                      <Setter Property="AutomationProperties.Name" Value="Light" />
                      <Setter Property="AutomationProperties.AutomationId" Value="SettingsThemeLight" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding}" Value="Dark">
                      <Setter Property="AutomationProperties.Name" Value="Dark" />
                      <Setter Property="AutomationProperties.AutomationId" Value="SettingsThemeDark" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ComboBox.ItemContainerStyle>
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock>
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Follow system" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding}" Value="Light">
                            <Setter Property="Text" Value="Light" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding}" Value="Dark">
                            <Setter Property="Text" Value="Dark" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
        </StackPanel>
      </Border>

      <Border Style="{DynamicResource CardBorderStyle}" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Text="Where snapshots live" Style="{DynamicResource SectionTitleStyle}"
                     Foreground="{DynamicResource TextBrush}" />
          <TextBlock Text="Snapshots stay on this PC in the folder you pick when you create one. Nothing is uploaded, and WinRestoreKit never writes into a snapshot while comparing."
                     TextWrapping="Wrap" FontSize="13" Margin="0,8,0,0"
                     Foreground="{DynamicResource MutedTextBrush}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
