<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Neutral Windows surfaces. Nothing is pure white; every neutral is tinted cool. -->
  <Color x:Key="WindowBackgroundColor">#FFF3F5F7</Color>
  <Color x:Key="SurfaceColor">#FFFCFDFE</Color>
  <Color x:Key="SurfaceAltColor">#FFEDEFF3</Color>
  <Color x:Key="SubtleColor">#FFE8ECF1</Color>
  <Color x:Key="HoverColor">#FFEAEEF3</Color>
  <Color x:Key="PressedColor">#FFDFE4EB</Color>
  <Color x:Key="SelectedColor">#FFE4EFF8</Color>
  <Color x:Key="ControlBackgroundColor">#FFFFFFFF</Color>
  <Color x:Key="ControlBorderColor">#FFC7CDD6</Color>

  <Color x:Key="TextColor">#FF16191D</Color>
  <Color x:Key="MutedTextColor">#FF576170</Color>
  <Color x:Key="DisabledTextColor">#FF929BA8</Color>

  <Color x:Key="DividerColor">#FFDBE0E6</Color>
  <Color x:Key="StrongDividerColor">#FFBFC6D0</Color>

  <!-- One mineral blue carries every action and every "available" state. -->
  <Color x:Key="AccentColor">#FF1769AA</Color>
  <Color x:Key="AccentHoverColor">#FF135D96</Color>
  <Color x:Key="AccentPressedColor">#FF0F4E7F</Color>
  <Color x:Key="AccentSoftColor">#FFE3EEF7</Color>
  <Color x:Key="AccentTextColor">#FF135F9B</Color>
  <Color x:Key="OnAccentColor">#FFFFFFFF</Color>
  <Color x:Key="FocusColor">#FF0F4E7F</Color>

  <!-- One restrained coral carries caution and failure; glyph and text separate them. -->
  <Color x:Key="WarningColor">#FFB44E3C</Color>
  <Color x:Key="WarningTextColor">#FF9C4231</Color>
  <Color x:Key="WarningSoftColor">#FFFAEDE9</Color>
  <Color x:Key="DangerColor">#FFA83B2B</Color>
  <Color x:Key="DangerHoverColor">#FF953325</Color>
  <Color x:Key="DangerPressedColor">#FF7E2B1F</Color>
  <Color x:Key="DangerTextColor">#FF963425</Color>
  <Color x:Key="DangerSoftColor">#FFF8E8E4</Color>
  <Color x:Key="OnDangerColor">#FFFFFFFF</Color>

  <!-- Muted green, reserved for completed-run outcomes. -->
  <Color x:Key="SuccessColor">#FF2F7D4F</Color>
  <Color x:Key="SuccessTextColor">#FF2A6E46</Color>
  <Color x:Key="SuccessSoftColor">#FFE7F2EB</Color>

  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
  <SolidColorBrush x:Key="SubtleBrush" Color="{StaticResource SubtleColor}" />
  <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
  <SolidColorBrush x:Key="PressedBrush" Color="{StaticResource PressedColor}" />
  <SolidColorBrush x:Key="SelectedBrush" Color="{StaticResource SelectedColor}" />
  <SolidColorBrush x:Key="ControlBackgroundBrush" Color="{StaticResource ControlBackgroundColor}" />
  <SolidColorBrush x:Key="ControlBorderBrush" Color="{StaticResource ControlBorderColor}" />

  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
  <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource DisabledTextColor}" />

  <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />
  <SolidColorBrush x:Key="StrongDividerBrush" Color="{StaticResource StrongDividerColor}" />

  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
  <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />
  <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
  <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource FocusColor}" />

  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
  <SolidColorBrush x:Key="WarningTextBrush" Color="{StaticResource WarningTextColor}" />
  <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoftColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="DangerHoverBrush" Color="{StaticResource DangerHoverColor}" />
  <SolidColorBrush x:Key="DangerPressedBrush" Color="{StaticResource DangerPressedColor}" />
  <SolidColorBrush x:Key="DangerTextBrush" Color="{StaticResource DangerTextColor}" />
  <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}" />
  <SolidColorBrush x:Key="OnDangerBrush" Color="{StaticResource OnDangerColor}" />

  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
  <SolidColorBrush x:Key="SuccessTextBrush" Color="{StaticResource SuccessTextColor}" />
  <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoftColor}" />
</ResourceDictionary>
