<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Neutral Windows surfaces. Nothing is pure black; every neutral is tinted cool. -->
  <Color x:Key="WindowBackgroundColor">#FF16191E</Color>
  <Color x:Key="SurfaceColor">#FF1E222A</Color>
  <Color x:Key="SurfaceAltColor">#FF262B34</Color>
  <Color x:Key="SubtleColor">#FF2B313B</Color>
  <Color x:Key="HoverColor">#FF2A303A</Color>
  <Color x:Key="PressedColor">#FF333A45</Color>
  <Color x:Key="SelectedColor">#FF1D3244</Color>
  <Color x:Key="ControlBackgroundColor">#FF262B34</Color>
  <Color x:Key="ControlBorderColor">#FF454C58</Color>

  <Color x:Key="TextColor">#FFF0F3F7</Color>
  <Color x:Key="MutedTextColor">#FFA9B3C0</Color>
  <Color x:Key="DisabledTextColor">#FF6B7583</Color>

  <Color x:Key="DividerColor">#FF343A45</Color>
  <Color x:Key="StrongDividerColor">#FF4A525E</Color>

  <!-- One mineral blue carries every action and every "available" state. -->
  <Color x:Key="AccentColor">#FF5EA7E0</Color>
  <Color x:Key="AccentHoverColor">#FF76B6E9</Color>
  <Color x:Key="AccentPressedColor">#FF4A92CB</Color>
  <Color x:Key="AccentSoftColor">#FF1B2C3B</Color>
  <Color x:Key="AccentTextColor">#FF83BEEE</Color>
  <Color x:Key="OnAccentColor">#FF0E1B25</Color>
  <Color x:Key="FocusColor">#FF8CC6F0</Color>

  <!-- One restrained coral carries caution and failure; glyph and text separate them. -->
  <Color x:Key="WarningColor">#FFEF8E7B</Color>
  <Color x:Key="WarningTextColor">#FFF39D8B</Color>
  <Color x:Key="WarningSoftColor">#FF33231F</Color>
  <Color x:Key="DangerColor">#FFEF8E7B</Color>
  <Color x:Key="DangerHoverColor">#FFF4A08F</Color>
  <Color x:Key="DangerPressedColor">#FFD97A68</Color>
  <Color x:Key="DangerTextColor">#FFF39D8B</Color>
  <Color x:Key="DangerSoftColor">#FF33221E</Color>
  <Color x:Key="OnDangerColor">#FF2A100B</Color>

  <!-- Muted green, reserved for completed-run outcomes. -->
  <Color x:Key="SuccessColor">#FF6FC08D</Color>
  <Color x:Key="SuccessTextColor">#FF83CB9D</Color>
  <Color x:Key="SuccessSoftColor">#FF1B2A22</Color>

  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
  <SolidColorBrush x:Key="SubtleBrush" Color="{StaticResource SubtleColor}" />
  <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
  <SolidColorBrush x:Key="PressedBrush" Color="{StaticResource PressedColor}" />
  <SolidColorBrush x:Key="SelectedBrush" Color="{StaticResource SelectedColor}" />
  <SolidColorBrush x:Key="ControlBackgroundBrush" Color="{StaticResource ControlBackgroundColor}" />
  <SolidColorBrush x:Key="ControlBorderBrush" Color="{StaticResource ControlBorderColor}" />

  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
  <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource DisabledTextColor}" />

  <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />
  <SolidColorBrush x:Key="StrongDividerBrush" Color="{StaticResource StrongDividerColor}" />

  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
  <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />
  <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
  <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource FocusColor}" />

  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
  <SolidColorBrush x:Key="WarningTextBrush" Color="{StaticResource WarningTextColor}" />
  <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoftColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="DangerHoverBrush" Color="{StaticResource DangerHoverColor}" />
  <SolidColorBrush x:Key="DangerPressedBrush" Color="{StaticResource DangerPressedColor}" />
  <SolidColorBrush x:Key="DangerTextBrush" Color="{StaticResource DangerTextColor}" />
  <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}" />
  <SolidColorBrush x:Key="OnDangerBrush" Color="{StaticResource OnDangerColor}" />

  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
  <SolidColorBrush x:Key="SuccessTextBrush" Color="{StaticResource SuccessTextColor}" />
  <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoftColor}" />
</ResourceDictionary>
