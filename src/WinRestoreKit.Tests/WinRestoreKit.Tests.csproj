<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>WinRestoreKit.Tests</RootNamespace>
    <AssemblyName>WinRestoreKit.Tests</AssemblyName>
    <!--
      The code under test lives in a WinForms assembly (WinRestoreKit references System.Windows.Forms
      from its type graph), so the test project must pull in the same WindowsDesktop framework
      reference in order to resolve those types. No test opens a window.
    -->
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Match the production project's settings so test code compiles under the same rules. -->
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinRestoreKit\WinRestoreKit.csproj" />
    <ProjectReference Include="..\WinRestoreKit.Application\WinRestoreKit.Application.csproj">
      <Aliases>global,Application</Aliases>
    </ProjectReference>
    <ProjectReference Include="..\WinRestoreKit.Wpf\WinRestoreKit.Wpf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Copy the REAL Properties/AssemblyInfo.cs next to the test binaries so the parser tests can run
      against the exact bytes the deployed update checker downloads from GitHub raw, rather than
      against a hand-copied approximation that could silently drift. Build action is None, so it is
      never compiled into this assembly - it is test data only.
    -->
    <None Include="..\WinRestoreKit\Properties\AssemblyInfo.cs" Link="TestData\AssemblyInfo.cs">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
